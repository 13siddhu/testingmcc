<script>
(function() {
  const MIDDLEWARE = "https://mycoffeeco-middleware-original.onrender.com";

  // ── STATE ──
  let cart = {};
  let menuData = null;
  let searchTerm = "";
  let detailCategoryId = null;

  // ── DOM REFS ──
  const branchSelect     = document.getElementById('branch-select');
  const branchSelectCart = document.getElementById('branch-select-cart');
  const channelSelect    = document.getElementById('channel-select');
  // Cart screen's branch dropdown mirrors the home one's options (kept in
  // sync below) since the home <select> lives inside a view that's
  // display:none while the Cart view is showing, and a hidden ancestor
  // can't be focused/opened.
  branchSelectCart.innerHTML = branchSelect.innerHTML;
  branchSelectCart.value = branchSelect.value;
  const branchLabel   = document.getElementById('home-branch-label');
  const loading       = document.getElementById('menu-loading');
  const errorEl       = document.getElementById('menu-error');
  const searchEmptyEl = document.getElementById('search-empty');
  const homeRows      = document.getElementById('home-rows');
  const detailGrid    = document.getElementById('detail-grid');
  const categoriesGrid = document.getElementById('categories-grid');
  const searchInput   = document.getElementById('menu-search');

  // ── VIEW ROUTING ──
  const views = ['home', 'categories', 'detail', 'loyalty', 'cart', 'account', 'edit-profile'];

  function showView(name) {
    views.forEach(v => {
      const el = document.getElementById('view-' + v);
      if (el) el.style.display = (v === name) ? '' : 'none';
    });
    document.querySelectorAll('.rista-nav-item').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.nav === name);
    });
    window.scrollTo({ top: 0 });
  }

  const bindClick = (id, fn) => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('click', fn);
  };

  bindClick('nav-home', () => showView('home'));
  bindClick('nav-category', () => showView('categories'));
  bindClick('nav-loyalty', () => showView('loyalty'));
  bindClick('nav-cart-btn', () => showView('cart'));
  bindClick('open-categories-btn', () => showView('categories'));
  bindClick('detail-back', () => showView('categories'));
  bindClick('cart-back', () => showView('home'));
  bindClick('account-back', () => showView('home'));
  bindClick('login-back', () => showView('home'));
  bindClick('account-loyalty-link', () => showView('loyalty'));
  ['edit-profile-trigger-btn', 'account-info-trigger-btn'].forEach(id => {
    bindClick(id, () => showView('edit-profile'));
  });
  bindClick('edit-profile-back', () => showView('account'));

  ['cart-icon-cat','cart-icon-detail','cart-icon-loy','cart-icon-self','cart-icon-acc'].forEach(id => {
    bindClick(id, () => showView('cart'));
  });
  ['account-entry','account-entry-2','account-entry-3'].forEach(id => {
    bindClick(id, () => showView('account'));
  });

  // Check URL parameters to open target view after login redirect
  const urlParams = new URLSearchParams(window.location.search);
  const initialView = urlParams.get('view');
  if (initialView && views.includes(initialView)) {
    showView(initialView);
  }

  // ── EDIT PROFILE LOGIC ──
  const editProfileForm = document.getElementById('edit-profile-form');
  const avatarFileInput = document.getElementById('avatar-file-input');
  const changeAvatarBtn = document.getElementById('change-avatar-btn');
  const profileAvatarCircle = document.getElementById('profile-avatar-circle');

  if (changeAvatarBtn && avatarFileInput) {
    changeAvatarBtn.addEventListener('click', () => avatarFileInput.click());
    avatarFileInput.addEventListener('change', function() {
      const file = this.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          if (profileAvatarCircle) profileAvatarCircle.innerHTML = `<img src="${e.target.result}" alt="Profile avatar">`;
          localStorage.setItem('mcc_user_avatar', e.target.result);
        };
        reader.readAsDataURL(file);
      }
    });
  }

  const savedAvatar = localStorage.getItem('mcc_user_avatar');
  if (savedAvatar && profileAvatarCircle) {
    profileAvatarCircle.innerHTML = `<img src="${savedAvatar}" alt="Profile avatar">`;
  }

  if (editProfileForm) {
    editProfileForm.addEventListener('submit', function(e) {
      e.preventDefault();
      const saveBtn = document.getElementById('save-profile-btn');
      const originalText = saveBtn.textContent;
      saveBtn.textContent = 'Saving...';
      saveBtn.disabled = true;

      const nameVal = document.getElementById('profile-name-input').value.trim();
      const phoneVal = document.getElementById('profile-phone-input').value.trim();
      const emailVal = document.getElementById('profile-email-input').value.trim();
      const dobVal = document.getElementById('profile-dob-input').value;
      const genderVal = document.getElementById('profile-gender-select').value;
      const nationalityVal = document.getElementById('profile-nationality-input').value.trim();

      localStorage.setItem('mcc_user_name', nameVal);
      localStorage.setItem('mcc_user_phone', phoneVal);
      localStorage.setItem('mcc_user_email', emailVal);
      localStorage.setItem('mcc_user_dob', dobVal);
      localStorage.setItem('mcc_user_gender', genderVal);
      localStorage.setItem('mcc_user_nationality', nationalityVal);

      const nameEl = document.querySelector('.rista-profile-name');
      const phoneEl = document.querySelector('.rista-profile-phone');
      if (nameEl && nameVal) nameEl.textContent = nameVal;
      if (phoneEl && phoneVal) phoneEl.textContent = '+91 ' + phoneVal;

      fetch(`${MIDDLEWARE}/api/customers/sync`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: nameVal,
          phone: phoneVal ? '+91' + phoneVal : '',
          email: emailVal,
          dob: dobVal,
          gender: genderVal,
          nationality: nationalityVal
        })
      }).catch(err => console.warn('Customer sync warning:', err));

      setTimeout(() => {
        saveBtn.textContent = 'Saved! ✓';
        setTimeout(() => {
          saveBtn.textContent = originalText;
          saveBtn.disabled = false;
          showView('account');
        }, 600);
      }, 400);
    });
  }

  // ── OFFSETS (theme header/footer fix) ──
  function detectSiteHeaderHeight() {
    let maxHeight = 0;
    document.querySelectorAll('body > *, header, [class*="header"], [id*="header"]').forEach(function(el) {
      if (el.closest('.rista-app')) return;
      const cs = getComputedStyle(el);
      if ((cs.position === 'fixed' || cs.position === 'sticky') &&
          parseInt(cs.top) <= 5 && el.offsetHeight > 0 && el.offsetHeight < 300) {
        maxHeight = Math.max(maxHeight, el.offsetHeight);
      }
    });
    return maxHeight;
  }
  function detectSiteFooterHeight() {
    let maxHeight = 0;
    document.querySelectorAll('body > *, footer, [class*="footer"], [id*="footer"], [class*="bottom-nav"], [class*="tabbar"], nav').forEach(function(el) {
      if (el.closest('.rista-app')) return;
      const cs = getComputedStyle(el);
      if (cs.position === 'fixed' && parseInt(cs.bottom) <= 5 && el.offsetHeight > 0 && el.offsetHeight < 200) {
        maxHeight = Math.max(maxHeight, el.offsetHeight);
      }
    });
    return maxHeight;
  }
  function hideThemeBottomNav() {
    document.querySelectorAll('body > *, footer, [class*="footer"], [id*="footer"], [class*="bottom-nav"], [class*="tabbar"], nav').forEach(function(el) {
      if (el.closest('.rista-app')) return;
      const cs = getComputedStyle(el);
      if (cs.position === 'fixed' && parseInt(cs.bottom) <= 5 && el.offsetHeight > 0 && el.offsetHeight < 200) {
        el.style.display = 'none';
      }
    });
  }
  // FIX: snap the page back to horizontal position 0 any time offsets are
  // recalculated (initial load, resize, after menu render) — a safety net
  // in case anything still nudges the document sideways.
  function applyOffsets() {
    hideThemeBottomNav();
    const app = document.getElementById('rista-app');
    if (app) {
      let parent = app.parentElement;
      while (parent && parent !== document.body) {
        parent.style.paddingLeft = '0px';
        parent.style.paddingRight = '0px';
        parent.style.paddingTop = '0px';
        parent.style.marginLeft = '0px';
        parent.style.marginRight = '0px';
        parent.style.marginTop = '0px';
        parent.style.maxWidth = '100%';
        parent = parent.parentElement;
      }
    }
    document.documentElement.style.setProperty('--rista-header-offset', detectSiteHeaderHeight() + 'px');
    document.documentElement.style.setProperty('--rista-footer-offset', detectSiteFooterHeight() + 'px');
    document.documentElement.scrollLeft = 0;
    document.body.scrollLeft = 0;
    window.scrollTo(0, window.scrollY);
  }
  window.addEventListener('load', applyOffsets);
  window.addEventListener('resize', applyOffsets);

  // ── BRANCH / CHANNEL ──
  function updateChannels() {
    if (branchSelectCart.value !== branchSelect.value) branchSelectCart.value = branchSelect.value;
    const opt = branchSelect.options[branchSelect.selectedIndex];
    const channels = (opt.dataset.channels || "Takeaway").split(",");
    const current = channelSelect.value;
    channelSelect.innerHTML = channels.map(ch =>
      `<option value="${ch}" ${ch === current ? 'selected' : ''}>${ch}</option>`
    ).join('');
    updateLabels();
  }
  function updateLabels() {
    const branchText = branchSelect.options[branchSelect.selectedIndex].text;
    const channelVal = channelSelect.value || 'Website';

    const channelLabelEl = document.getElementById('home-channel-label');
    const channelIconEl  = document.getElementById('home-channel-icon');
    if (channelLabelEl) channelLabelEl.textContent = channelVal;
    if (channelIconEl) {
      if (channelVal === 'Website') channelIconEl.textContent = '🌐';
      else if (channelVal === 'Delivery') channelIconEl.textContent = '🛵';
      else if (channelVal === 'Dine In') channelIconEl.textContent = '🍽️';
      else if (channelVal === 'Takeaway') channelIconEl.textContent = '🛍️';
      else channelIconEl.textContent = '🛍️';
    }

    if (branchLabel) branchLabel.textContent = branchText;

    const pickupChannelLabel = document.getElementById('pickup-channel-label');
    const pickupBranchLabel  = document.getElementById('pickup-branch-label');
    if (pickupChannelLabel) pickupChannelLabel.textContent = channelVal + ' Order';
    if (pickupBranchLabel)  pickupBranchLabel.textContent  = 'at ' + branchText;
  }
  branchSelectCart.addEventListener('change', function() {
    branchSelect.value = branchSelectCart.value;
    updateChannels();
    loadMenu();
  });

  // ── LOAD MENU ──
  function loadMenu() {
    const branch = branchSelect.value;
    const channel = channelSelect.value;

    loading.style.display = 'block';
    errorEl.style.display = 'none';
    homeRows.innerHTML = '';

    fetch(`${MIDDLEWARE}/api/menu?branch=${encodeURIComponent(branch)}&channel=${encodeURIComponent(channel)}`)
      .then(r => r.json())
      .then(data => {
        if (!data.success) throw new Error(data.message || 'Failed');
        menuData = data;
        renderHomeRows(data.categories);
        renderCategoriesGrid(data.categories);
        applyOffsets();
      })
      .catch(() => { errorEl.style.display = 'block'; })
      .finally(() => { loading.style.display = 'none'; });
  }

  // ── IMAGE HELPERS ──
  window.skuImageMap = window.skuImageMap || {};
  function getItemImage(item) {
    if (item.image || item.imageUrl || item.img || item.imageURL) {
      return item.image || item.imageUrl || item.img || item.imageURL;
    }
    if (item.skuCode && window.skuImageMap[item.skuCode]) {
      return window.skuImageMap[item.skuCode];
    }
    return null;
  }
  function cardImageHTML(item) {
    const src = getItemImage(item);
    if (src) return `<img class="rista-card-img" src="${src}" alt="${escapeAttr(item.name)}" loading="lazy" decoding="async">`;
    return `<div class="rista-card-img-fallback">${(item.name || '?').charAt(0).toUpperCase()}</div>`;
  }
  function escapeAttr(str) { return (str || '').replace(/'/g, "\\'"); }

  // ── SIZE BOTTOM SHEET ──
  // Created once on DOMContentLoaded, reused for every Group item tap
  function initSizeSheet() {
    if (document.getElementById('size-sheet-overlay')) return; // already exists
    const sheet = document.createElement('div');
    sheet.id = 'size-sheet-overlay';
    sheet.innerHTML = `
      <div class="size-sheet" id="size-sheet">
        <div class="size-sheet-handle"></div>
        <div class="size-sheet-header">
          <div class="size-sheet-img-wrap" id="size-sheet-img"></div>
          <div class="size-sheet-info">
            <div class="size-sheet-name" id="size-sheet-name"></div>
          </div>
        </div>
        <div class="size-sheet-label">Choose Size</div>
        <div class="size-pills" id="size-pills"></div>
        <button class="size-sheet-close" id="size-sheet-close" aria-label="Close">✕</button>
      </div>
    `;
    document.body.appendChild(sheet);
    document.getElementById('size-sheet-close').addEventListener('click', closeSizeSheet);
    sheet.addEventListener('click', function(e) { if (e.target === sheet) closeSizeSheet(); });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSizeSheet);
  } else {
    initSizeSheet();
  }

  function openSizeSheet(skuCode) {
    const item = window.__menuItems[skuCode];
    if (!item) return;
    const overlay = document.getElementById('size-sheet-overlay');
    document.getElementById('size-sheet-name').textContent = item.name;

    // Image
    const imgWrap = document.getElementById('size-sheet-img');
    const src = getItemImage(item);
    imgWrap.innerHTML = src
      ? `<img src="${src}" alt="${escapeAttr(item.name)}">`
      : `<div class="size-sheet-img-fallback">${(item.name||'?').charAt(0).toUpperCase()}</div>`;

    // Render Size pills
    renderSizePills(item);

    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeSizeSheet() {
    const overlay = document.getElementById('size-sheet-overlay');
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  }

  function renderSizePills(item) {
    const pillsEl = document.getElementById('size-pills');
    if (!pillsEl || !item || !item.variants) return;

    pillsEl.innerHTML = item.variants.map((v, idx) => {
      const varSku = String(v.skuCode || (item.skuCode + '-v-' + idx));
      const parentSkuStr = String(item.skuCode || '');
      v.skuCode = varSku;
      window.__variantParentMap[varSku] = parentSkuStr;
      window.__menuItems[varSku] = { skuCode: varSku, name: item.name, variant: v.label, price: Number(v.price) || 0, tax: Number(v.tax) || 0 };

      const inCart  = cart[varSku];
      const qty     = inCart ? inCart.qty : 0;
      const unavail = v.available === false;

      let actionHTML = '';
      if (unavail) {
        actionHTML = '<span class="size-sold-out">Sold out</span>';
      } else if (qty === 0) {
        actionHTML = `<button type="button" data-add-variant="${varSku}" data-parent-sku="${item.skuCode}" style="background:#0a06ff !important;background-color:#0a06ff !important;background-image:none !important;color:#fff !important;border:none !important;padding:8px 20px !important;border-radius:20px !important;font-weight:800 !important;font-size:0.88rem !important;cursor:pointer !important;outline:none !important;box-shadow:0 2px 8px rgba(10,6,255,0.3) !important;display:inline-flex !important;align-items:center !important;justify-content:center !important;text-decoration:none !important;-webkit-appearance:none !important;appearance:none !important;">+ Add</button>`;
      } else {
        actionHTML = `
          <div class="size-stepper">
            <button type="button" data-variant-qty="${varSku}" data-parent-sku="${item.skuCode}" data-delta="-1">−</button>
            <span>${qty}</span>
            <button type="button" data-variant-qty="${varSku}" data-parent-sku="${item.skuCode}" data-delta="1">+</button>
          </div>
        `;
      }

      let displayLabel = v.label;
      if (!displayLabel || displayLabel.toLowerCase() === item.name.toLowerCase()) {
        displayLabel = `Option ${idx + 1}`;
      }

      return `
        <div class="size-pill-row${unavail ? ' unavail' : ''}" ${unavail ? '' : `data-add-variant="${varSku}" data-parent-sku="${item.skuCode}"`}>
          <div class="size-pill-left">
            <span class="size-pill-label">${displayLabel}</span>
            <span class="size-pill-price">₹${v.price}</span>
          </div>
          <div class="size-pill-action">${actionHTML}</div>
        </div>
      `;
    }).join('');
  }

  // Rows are built via innerHTML after the menu fetch resolves. On some
  // mobile browsers, injecting a horizontally-scrollable flex row into an
  // already-rendered page leaves it initialized at a non-zero scrollLeft
  // (content appears pre-scrolled, cutting off the left edge of the first
  // card). Forcing scrollLeft back to 0 on the next frame after each
  // insertion is the reliable fix.
  function resetRowScroll(container) {
    requestAnimationFrame(() => {
      (container ? container.querySelectorAll('.rista-scroll-row') : document.querySelectorAll('.rista-scroll-row'))
        .forEach(row => { row.scrollLeft = 0; });
    });
  }

  // ── ITEM CARD ──
  // Items are stored in window.__menuItems by skuCode so openSizeSheet
  // and event delegation can look them up safely.
  window.__menuItems = window.__menuItems || {};
  window.__variantParentMap = window.__variantParentMap || {};

  function cardHTML(item) {
    const itemSku = item.skuCode || item.itemId || ('item-' + Math.random().toString(36).substring(2, 9));
    item.skuCode = itemSku;
    const soldOut = !item.available;
    const isNew   = item.isNew || (item.tags && item.tags.indexOf('new') !== -1);
    const isGroup = item.type === 'Group' && item.variants && item.variants.length > 0;

    // Store item for safe lookup
    window.__menuItems[itemSku] = item;
    if (isGroup) {
      item.variants.forEach(v => {
        if (v.skuCode) {
          window.__variantParentMap[v.skuCode] = itemSku;
        }
      });
    }

    // For group items, show total qty across all sizes in the badge
    const totalQty = isGroup
      ? item.variants.reduce((sum, v) => sum + (cart[v.skuCode] ? cart[v.skuCode].qty : 0), 0)
      : (cart[itemSku] ? cart[itemSku].qty : 0);

    const priceLabel = isGroup ? `from ₹${item.price}` : `₹${item.price}`;

    return `
      <div class="rista-card${soldOut ? ' sold-out' : ''}" id="card-${itemSku}">
        ${isNew ? '<span class="rista-card-badge">New</span>' : ''}
        ${totalQty > 0 ? `<span class="rista-card-qty-badge">${totalQty}</span>` : ''}
        ${cardImageHTML(item)}
        <div class="rista-card-body">
          <div class="rista-card-name">${item.name}</div>
          <div class="rista-card-bottom-row">
            <span class="rista-card-price">${priceLabel}</span>
            ${soldOut ? '<span class="rista-sold-label">Sold out</span>' :
              isGroup
                ? `<button class="rista-add-pill" type="button" data-open-sheet="${itemSku}">
                     ${totalQty > 0 ? `<span class="rista-card-qty-inline">${totalQty}</span> sizes` : '+ Add'}
                   </button>`
                : cardActionHTML(item, cart[itemSku], '')
            }
          </div>
        </div>
      </div>
    `;
  }
  function cardActionHTML(item, inCart, variantText) {
    const itemSku = item.skuCode || item.itemId;
    if (!inCart || inCart.qty === 0) {
      return `<button class="rista-add-pill" type="button" data-add-simple="${itemSku}">+ Add</button>`;
    }
    return `
      <div class="rista-qty-pill">
        <button type="button" data-qty-change="${itemSku}" data-delta="-1">−</button>
        <span class="qty">${inCart.qty}</span>
        <button type="button" data-qty-change="${itemSku}" data-delta="1">+</button>
      </div>
    `;
  }

  // ── HOME: one row per category ──
  function renderHomeRows(categories) {
    if (!categories || !categories.length) {
      homeRows.innerHTML = '<p class="rista-state">No items available.</p>';
      return;
    }
    homeRows.innerHTML = categories.map(cat => {
      if (!cat.items || !cat.items.length) return '';
      const items = cat.items.slice(0, 10);
      return `
        <div class="rista-home-row">
          <div class="rista-home-row-head">
            <h3 class="rista-home-row-title">${cat.name}</h3>
            <button class="rista-home-row-viewall" data-cat-id="${cat.categoryId}">View All ›</button>
          </div>
          <div class="rista-scroll-row">${items.map(cardHTML).join('')}</div>
        </div>
      `;
    }).join('');
    homeRows.querySelectorAll('.rista-home-row-viewall').forEach(btn => {
      btn.addEventListener('click', function() { openCategoryDetail(this.dataset.catId); });
    });
    resetRowScroll(homeRows);
  }

  // ── CATEGORIES SCREEN (3-col tiles) ──
  function getCategoryImage(cat) {
    const direct = cat.image || cat.imageUrl || cat.img || cat.imageURL;
    if (direct) return direct;
    const firstItem = (cat.items || [])[0];
    return firstItem ? getItemImage(firstItem) : null;
  }
  function renderCategoriesGrid(categories) {
    categoriesGrid.innerHTML = (categories || []).map(cat => {
      const src = getCategoryImage(cat);
      const imgHTML = src
        ? `<img src="${src}" alt="${escapeAttr(cat.name)}" loading="lazy" decoding="async">`
        : (cat.name || '?').charAt(0).toUpperCase();
      return `
        <div class="rista-cat-tile" data-cat-id="${cat.categoryId}">
          <div class="rista-cat-tile-img">${imgHTML}</div>
          <div class="rista-cat-tile-label">${cat.name}</div>
          <button class="rista-cat-tile-arrow">→</button>
        </div>
      `;
    }).join('');
    categoriesGrid.querySelectorAll('.rista-cat-tile').forEach(el => {
      el.addEventListener('click', function() { openCategoryDetail(this.dataset.catId); });
    });
  }

  // ── CATEGORY DETAIL / SEARCH RESULTS ──
  function openCategoryDetail(categoryId) {
    if (!menuData) return;
    detailCategoryId = categoryId;
    const cat = menuData.categories.find(c => String(c.categoryId) === String(categoryId));
    if (!cat) return;
    document.getElementById('detail-title').textContent = cat.name;
    searchEmptyEl.style.display = 'none';
    detailGrid.innerHTML = (cat.items || []).map(cardHTML).join('');
    showView('detail');
  }
  function renderSearchResults(term) {
    if (!menuData) return;
    const matches = [];
    menuData.categories.forEach(cat => (cat.items || []).forEach(item => {
      if (item.name.toLowerCase().includes(term)) matches.push(item);
    }));
    document.getElementById('detail-title').textContent = 'Search results';
    if (matches.length === 0) {
      detailGrid.innerHTML = '';
      searchEmptyEl.style.display = 'block';
    } else {
      searchEmptyEl.style.display = 'none';
      detailGrid.innerHTML = matches.map(cardHTML).join('');
    }
    showView('detail');
  }

  // ── RE-RENDER ONE ITEM'S ACTION AREA EVERYWHERE IT APPEARS ──
  function refreshItemUI(skuCode) {
    if (!menuData || !skuCode) return;
    let item = menuData.categories.flatMap(c => c.items).find(i => String(i.skuCode) === String(skuCode));
    if (!item && window.__variantParentMap[skuCode]) {
      const parentSku = window.__variantParentMap[skuCode];
      item = menuData.categories.flatMap(c => c.items).find(i => String(i.skuCode) === String(parentSku));
    }
    if (!item) return;
    const targetSku = item.skuCode;
    document.querySelectorAll(`[id="card-${targetSku}"]`).forEach(cardEl => { cardEl.outerHTML = cardHTML(item); });
  }

  // ── CART LOGIC ──
  window.addItem = function(skuCode, name, variant, price, tax) {
    let item = window.__menuItems[skuCode];
    if (!item && menuData) {
      item = menuData.categories.flatMap(c => c.items).find(i => String(i.skuCode) === String(skuCode));
    }
    const itemName = name || (item ? item.name : 'Item');
    const itemPrice = price !== undefined ? price : (item ? item.price : 0);
    const itemTax = tax !== undefined ? tax : (item ? (item.tax || 0) : 0);
    const itemVariant = variant || '';

    if (!cart[skuCode]) {
      cart[skuCode] = { skuCode, name: itemName, variant: itemVariant, price: itemPrice, tax: itemTax, qty: 0 };
    }
    cart[skuCode].qty++;

    const parentSku = window.__variantParentMap[skuCode] || skuCode;
    refreshItemUI(parentSku);
    if (parentSku !== skuCode) refreshItemUI(skuCode);

    updateCartUI();
  };
  window.changeQty = function(skuCode, delta) {
    if (!cart[skuCode]) return;
    cart[skuCode].qty += delta;
    if (cart[skuCode].qty <= 0) delete cart[skuCode];

    const parentSku = window.__variantParentMap[skuCode] || skuCode;
    refreshItemUI(parentSku);
    if (parentSku !== skuCode) refreshItemUI(skuCode);

    updateCartUI();
  };

  function updateCartUI() {
    const items = Object.values(cart);
    const count = items.reduce((sum, i) => sum + i.qty, 0);

    // Update all cart badges
    ['nav-cart-badge','cart-badge-cat','cart-badge-detail','cart-badge-loy','cart-badge-self','cart-badge-acc'].forEach(id => {
      const badge = document.getElementById(id);
      if (!badge) return;
      badge.textContent = count;
      badge.style.display = count > 0 ? 'inline-flex' : 'none';
    });

    // Bill summary: base price (ex-tax) + 5% GST shown separately
    const subtotal  = items.reduce((sum, i) => sum + i.price * i.qty, 0);
    const taxAmount = items.reduce((sum, i) => sum + (i.tax || 0) * i.qty, 0);
    const grandTotal = subtotal + taxAmount;

    const subtotalEl = document.getElementById('cart-subtotal');
    if (subtotalEl) subtotalEl.textContent = `₹${subtotal}`;
    const taxEl = document.getElementById('cart-tax-included');
    if (taxEl) taxEl.textContent = `₹${taxAmount}`;
    const totalEl = document.getElementById('cart-total');
    if (totalEl) totalEl.textContent = `₹${grandTotal}`;

    const listEl    = document.getElementById('cart-items-list');
    const footerEl  = document.getElementById('cart-footer');
    const upsellWrap = document.getElementById('upsell-wrap');

    if (items.length === 0) {
      if (listEl) listEl.innerHTML = '<p class="rista-cart-empty">Your cart is empty</p>';
      if (footerEl) footerEl.style.display = 'none';
      if (upsellWrap) upsellWrap.style.display = 'none';
    } else {
      if (listEl) {
        listEl.innerHTML = items.map(i => `
          <div class="rista-cart-item-card">
            <div class="rista-cart-item-top">
              <div class="rista-cart-item-img-fallback">${i.name.charAt(0).toUpperCase()}</div>
              <div class="rista-cart-item-info">
                <div class="rista-cart-item-name">${i.name}</div>
                <div class="rista-cart-item-variant">${i.variant || 'Regular'}</div>
                <div class="rista-cart-item-price">₹${i.price}</div>
              </div>
              <button class="rista-cart-item-remove" type="button" data-cart-remove="${i.skuCode}" title="Remove item" aria-label="Remove item">✕</button>
            </div>
            <div class="rista-cart-item-qty-row">
              <div class="rista-cart-item-stepper">
                <button type="button" data-cart-stepper="${i.skuCode}" data-delta="-1">−</button>
                <span class="qty">${i.qty}</span>
                <button type="button" data-cart-stepper="${i.skuCode}" data-delta="1">+</button>
              </div>
            </div>
            <div class="rista-cart-item-bottom">
              <button class="rista-add-note">💬 Add a note</button>
              <span><span class="rista-item-total-label">Item Total&nbsp;</span><span class="rista-item-total-value">₹${i.price * i.qty}</span></span>
            </div>
          </div>
        `).join('');
      }
      if (footerEl) footerEl.style.display = 'block';
      renderUpsell(items);
    }
  }

  function renderUpsell(cartItems) {
    if (!menuData) return;
    const upsellWrap = document.getElementById('upsell-row');
    const cartSkus = new Set(cartItems.map(i => i.skuCode));
    const candidates = [];
    menuData.categories.forEach(cat => (cat.items || []).forEach(item => {
      if (!cartSkus.has(item.skuCode) && item.available) candidates.push(item);
    }));
    const picks = candidates.slice(0, 6);
    if (picks.length === 0) { document.getElementById('upsell-wrap').style.display = 'none'; return; }
    document.getElementById('upsell-wrap').style.display = 'block';
    upsellWrap.innerHTML = picks.map(cardHTML).join('');
    resetRowScroll(upsellWrap.parentElement);
  }

  // ── SEARCH ──
  let searchDebounce;
  searchInput.addEventListener('input', function() {
    clearTimeout(searchDebounce);
    const val = this.value;
    searchDebounce = setTimeout(() => {
      searchTerm = val.trim().toLowerCase();
      if (searchTerm) renderSearchResults(searchTerm);
    }, 200);
  });

  // ── PROMO CAROUSEL DOTS ──
  const promoTrack = document.getElementById('promo-track');
  if (promoTrack) {
    const dots = Array.from(document.querySelectorAll('.rista-dot'));
    if (dots.length) dots[0].classList.add('active');
    promoTrack.addEventListener('scroll', function() {
      const idx = Math.round(promoTrack.scrollLeft / promoTrack.clientWidth);
      dots.forEach((d, i) => d.classList.toggle('active', i === idx));
    });
  }

  // ── SKU → SHOPIFY VARIANT ID MAP ──
  let skuVariantMapPromise = null;
  function getSkuVariantMap() {
    if (skuVariantMapPromise) return skuVariantMapPromise;
    skuVariantMapPromise = (async () => {
      const map = {};
      let page = 1;
      const MAX_PAGES = 20;
      while (page <= MAX_PAGES) {
        const res = await fetch(`/products.json?limit=250&page=${page}`);
        if (!res.ok) break;
        const data = await res.json();
        const products = data.products || [];
        if (products.length === 0) break;
        products.forEach(p => {
          const pImg = (p.images && p.images.length > 0) ? p.images[0].src : null;
          (p.variants || []).forEach(v => {
            if (v.sku) {
              map[v.sku] = v.id;
              const img = v.featured_image ? v.featured_image.src : pImg;
              if (img) window.skuImageMap[v.sku] = img;
            }
          });
        });
        if (products.length < 250) break;
        page++;
      }
      return map;
    })();
    return skuVariantMapPromise;
  }

  // ── CHECKOUT ──
  document.getElementById('checkout-btn').addEventListener('click', async function() {
    const btn = this;
    const originalText = btn.textContent;
    const items = Object.values(cart);
    if (items.length === 0) return;

    btn.textContent = 'Preparing your order...';
    btn.disabled = true;

    try {
      // Clear existing Shopify cart first to avoid stale items from previous sessions
      await fetch('/cart/clear.js', { method: 'POST' });

      const skuMap = await getSkuVariantMap();
      const lineItems = [];
      const unmatched = [];
      items.forEach(item => {
        const variantId = skuMap[item.skuCode];
        if (variantId) lineItems.push({ id: variantId, quantity: item.qty });
        else unmatched.push(item.name);
      });

      if (lineItems.length === 0) {
        throw new Error(
          `Couldn't find "${unmatched.join('", "')}" in the store catalog. ` +
          `Make sure each menu item's SKU matches a Shopify product variant's SKU exactly.`
        );
      }

      const addRes = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: lineItems })
      });

      if (!addRes.ok) {
        const errData = await addRes.json().catch(() => ({}));
        throw new Error(errData.description || errData.message || 'Shopify rejected the cart update.');
      }

      if (unmatched.length > 0) {
        console.warn('Skipped items not found in store catalog:', unmatched);
        alert(`Note: "${unmatched.join('", "')}" couldn't be added (not found in store) — proceeding with the rest.`);
      }

     // Get referral code from localStorage if available
      const referralCode = localStorage.getItem('mcc_referral_code');
      const cartAttributes = {
        'rista_branch': branchSelect.value,
        'rista_channel': channelSelect.value
      };
      
      // Add referral code if present
      if (referralCode) {
        cartAttributes['referral_code'] = referralCode;
        console.log('[Checkout] Adding referral code to order:', referralCode);
      }
      
      await fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            attributes: cartAttributes
        })
      });

      window.location.href = '/checkout';

    } catch (err) {
      console.error('Checkout error:', err);
      btn.textContent = originalText;
      btn.disabled = false;
      alert(err.message || 'Something went wrong while checking out. Please try again.');
    }
  });

  // ── EVENT DELEGATION for size sheet + simple add + stepper buttons ──
  // Using delegation on the document so it works for the size sheet appended to the body
  document.addEventListener('click', function(e) {
    // Size sheet open button
    const sheetBtn = e.target.closest('[data-open-sheet]');
    if (sheetBtn) {
      e.stopPropagation();
      openSizeSheet(sheetBtn.dataset.openSheet);
      return;
    }

    // Variant quantity stepper button inside size sheet
    const varQtyBtn = e.target.closest('[data-variant-qty]');
    if (varQtyBtn) {
      e.stopPropagation();
      const varSku = String(varQtyBtn.dataset.variantQty || '');
      const parentSku = String(varQtyBtn.dataset.parentSku || '');
      const delta = parseInt(varQtyBtn.dataset.delta || '1', 10);
      changeQty(varSku, delta);

      const parentItem = window.__menuItems[parentSku] ||
        (menuData && menuData.categories.flatMap(c => c.items).find(i => String(i.skuCode) === parentSku));
      if (parentItem) renderSizePills(parentItem);
      return;
    }

    // Add variant item button or row click inside size sheet
    const addVarBtn = e.target.closest('[data-add-variant]');
    if (addVarBtn) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      
      // Force maintain button color immediately
      addVarBtn.style.cssText = 'background:#0a06ff !important;background-color:#0a06ff !important;color:#fff !important;background-image:none !important;border:none !important;padding:8px 20px !important;border-radius:20px !important;font-weight:800 !important;font-size:0.88rem !important;cursor:pointer !important;';
      
      const varSku = String(addVarBtn.dataset.addVariant || '');
      const parentSku = String(addVarBtn.dataset.parentSku || '');
      const varItem = window.__menuItems[varSku] || {};

      addItem(varSku, varItem.name, varItem.variant, varItem.price, varItem.tax);

      const parentItem = window.__menuItems[parentSku] ||
        (menuData && menuData.categories.flatMap(c => c.items).find(i => String(i.skuCode) === parentSku));
      if (parentItem) renderSizePills(parentItem);
      
      // Force button color again after re-render
      requestAnimationFrame(() => {
        const btns = document.querySelectorAll('[data-add-variant]');
        btns.forEach(btn => {
          btn.style.cssText = 'background:#0a06ff !important;background-color:#0a06ff !important;color:#fff !important;background-image:none !important;border:none !important;padding:8px 20px !important;border-radius:20px !important;font-weight:800 !important;font-size:0.88rem !important;cursor:pointer !important;';
        });
      });
      return;
    }

    // Add simple item button
    const addSimpleBtn = e.target.closest('[data-add-simple]');
    if (addSimpleBtn) {
      e.stopPropagation();
      addItem(addSimpleBtn.dataset.addSimple);
      return;
    }

    // Quantity change button on card
    const qtyBtn = e.target.closest('[data-qty-change]');
    if (qtyBtn) {
      e.stopPropagation();
      const delta = parseInt(qtyBtn.dataset.delta || '1', 10);
      changeQty(qtyBtn.dataset.qtyChange, delta);
      return;
    }

    // Remove item from cart button
    const removeBtn = e.target.closest('[data-cart-remove]');
    if (removeBtn) {
      e.stopPropagation();
      const sku = removeBtn.dataset.cartRemove;
      if (cart[sku]) {
        changeQty(sku, -cart[sku].qty);
      }
      return;
    }

    // Cart item stepper button
    const cartStepperBtn = e.target.closest('[data-cart-stepper]');
    if (cartStepperBtn) {
      e.stopPropagation();
      const delta = parseInt(cartStepperBtn.dataset.delta || '1', 10);
      changeQty(cartStepperBtn.dataset.cartStepper, delta);
      return;
    }
  });
  if (branchSelect) branchSelect.addEventListener('change', function() { updateChannels(); loadMenu(); });
  if (channelSelect) channelSelect.addEventListener('change', function() { updateLabels(); loadMenu(); });
  const hashView = (window.location.hash || '').replace('#', '');
  const queryView = new URLSearchParams(window.location.search).get('view');
  const isAccountPath = window.location.pathname.includes('/account') && !window.location.pathname.includes('/account/login') && !window.location.pathname.includes('/account/register');
  const startView = (views.indexOf(hashView) !== -1) ? hashView : ((views.indexOf(queryView) !== -1) ? queryView : (isAccountPath ? 'account' : 'home'));
  showView(startView);
  updateChannels();
  loadMenu();
  updateCartUI();
  applyOffsets();
  getSkuVariantMap();
  
  // ── AGGRESSIVE BUTTON COLOR ENFORCER ──
  // This watches for any button color changes and forces them back to blue
  const enforceButtonColors = () => {
    const addButtons = document.querySelectorAll('[data-add-variant], button[data-add-variant]');
    addButtons.forEach(btn => {
      const currentBg = window.getComputedStyle(btn).backgroundColor;
      const currentColor = window.getComputedStyle(btn).color;
      // Check if background is not blue or color is not white
      if (currentBg !== 'rgb(10, 6, 255)' || currentColor !== 'rgb(255, 255, 255)') {
        btn.style.cssText = 'background:#0a06ff !important;background-color:#0a06ff !important;color:#fff !important;background-image:none !important;border:none !important;padding:8px 20px !important;border-radius:20px !important;font-weight:800 !important;font-size:0.88rem !important;cursor:pointer !important;outline:none !important;';
      }
    });
  };
  
  // Run enforcer every 100ms
  setInterval(enforceButtonColors, 100);
  
  // Also enforce on any DOM changes
  const observer = new MutationObserver(enforceButtonColors);
  observer.observe(document.body, { 
    childList: true, 
    subtree: true, 
    attributes: true, 
    attributeFilter: ['style', 'class'] 
  });
})();
</script>

