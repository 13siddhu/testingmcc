{% endcomment %}
<meta name="robots" content="noindex, nofollow">

{% comment %}
  ══════════════════════════════════════════════════════════════
  REFERRAL TRACKING SCRIPT
  Captures referral codes from URL (?ref=CODE) and stores them
  for order attribution. Injected directly here since theme.liquid
  is not accessible in this Shopify setup.
  ══════════════════════════════════════════════════════════════
{% endcomment %}
<script>
(function() {
  'use strict';
  console.log('[Referral] Script loaded and running');

  const ReferralTracker = {
    STORAGE_KEY: 'mcc_referral_code',
    EXPIRY_KEY: 'mcc_referral_expiry',
    EXPIRY_DAYS: 30,
    
    init() {
      console.log('[Referral] Initializing tracker');
      this.captureReferralFromURL();
      this.displayReferralBanner();
    },
    
    captureReferralFromURL() {
      const urlParams = new URLSearchParams(window.location.search);
      const ref = urlParams.get('ref') || urlParams.get('referral') || urlParams.get('code');
      
      console.log('[Referral] Checking URL params. Found ref:', ref);
      
      if (ref) {
        this.validateAndStore(ref);
      } else {
        // Check if we already have a stored code
        const storedCode = this.getReferralCode();
        if (storedCode) {
          console.log('[Referral] Using stored code:', storedCode);
        } else {
          console.log('[Referral] No referral code found in URL or storage');
        }
      }
    },
    
    async validateAndStore(code) {
      console.log('[Referral] Validating code:', code);
      try {
        const response = await fetch(`https://mycoffeeco-middleware-original.onrender.com/api/referrals/validate/${code}`);
        const data = await response.json();
        
        console.log('[Referral] Validation response:', data);
        
        if (data.success && data.valid) {
          localStorage.setItem(this.STORAGE_KEY, code.toUpperCase());
          
          const expiryDate = new Date();
          expiryDate.setDate(expiryDate.getDate() + this.EXPIRY_DAYS);
          localStorage.setItem(this.EXPIRY_KEY, expiryDate.toISOString());
          
          console.log('[Referral] Code stored successfully:', code, 'Type:', data.referral.type);
          
          this.showBanner(`🎉 You're ordering via ${data.referral.name}'s link!`, 'success');
          this.cleanURL();
        } else {
          console.warn('[Referral] Invalid code:', code);
        }
      } catch (err) {
        console.error('[Referral] Validation failed:', err);
      }
    },
    
    getReferralCode() {
      const code = localStorage.getItem(this.STORAGE_KEY);
      const expiry = localStorage.getItem(this.EXPIRY_KEY);
      
      if (!code || !expiry) return null;
      
      if (new Date(expiry) < new Date()) {
        this.clearReferral();
        return null;
      }
      
      return code;
    },
    
    clearReferral() {
      localStorage.removeItem(this.STORAGE_KEY);
      localStorage.removeItem(this.EXPIRY_KEY);
    },
    
    displayReferralBanner() {
      const code = this.getReferralCode();
      if (!code) return;
      
      const existingBanner = document.getElementById('referral-banner');
      if (existingBanner) return;
      
      this.showBanner(`🎁 Referral code <strong>${code}</strong> applied!`, 'info', true);
    },
    
    showBanner(message, type = 'info', persistent = false) {
      const banner = document.createElement('div');
      banner.id = 'referral-banner';
      banner.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background: ${type === 'success' ? '#10b981' : '#3b82f6'};
        color: white;
        padding: 12px 16px;
        text-align: center;
        font-size: 14px;
        font-weight: 500;
        z-index: 99999;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      `;
      banner.innerHTML = message;
      
      document.body.prepend(banner);
      
      if (!persistent) {
        setTimeout(() => banner.remove(), 5000);
      }
    },
    
    cleanURL() {
      if (!window.history.replaceState) return;
      
      const url = new URL(window.location.href);
      url.searchParams.delete('ref');
      url.searchParams.delete('referral');
      url.searchParams.delete('code');
      
      window.history.replaceState({}, document.title, url.toString());
    }
  };
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => ReferralTracker.init());
  } else {
    ReferralTracker.init();
  }
  
  window.ReferralTracker = ReferralTracker;
  
})();
</script>

{% comment %}
  Rista Online Ordering Section — redesigned to match the "MY COFFEE CO." app
  mockups (MCC_online_ordering.pdf):
    1) Home — light header (Deliver to / greeting / logo), search bar,
       promo carousel, then one horizontal-scroll row PER Rista category
       ("Popular Picks" style), an info strip, bottom nav.
    2) Categories — solid blue header (bell / MY COFFEE CO. + tagline / cart),
       white rounded sheet, 3-col category tiles with circular arrow buttons.
    3) Category detail — blue header with back arrow, 2-col item grid for a
       single category (used by "View All" and by tapping a category tile).
    4) Loyalty Points — blue header, gradient points card, "How to Earn" card.
    5) Cart — blue header with back arrow, pickup/change bar, cart items,
       "Make it even better" upsell row, bill summary, checkout.
    6) My Account — blue header with back arrow, profile card, settings list.

  Views are swapped client-side (no page reloads) inside .rista-app. Menu
  data still comes from Rista via the middleware; checkout still adds the
  matching SKUs to the Shopify cart, unchanged from the previous version.

  NOTE on the "My Account" screen: the 5 mockup screens only show Home /
  Categories / Offer / Loyalty Points / Cart in the bottom nav — there's no
  6th tab for Account. A small avatar button was added next to the bell icon
  (top-right of the light + blue headers) as the entry point into Account,
  since the source mockups don't show where that screen is normally opened
  from. Adjust/remove #account-entry if you have a different entry point.

  FIX NOTES (page-shift / search bar cut off on the right):
  The page was drifting horizontally because (a) html/body allowed
  horizontal scroll, (b) .rista-app used overflow-x: clip instead of
  hidden, (c) some flex children (search input, greeting copy) had no
  min-width: 0 so they refused to shrink, and (d) touch swipes on the
  inner horizontal-scroll rows were bleeding into page-level horizontal
  scroll. All four are fixed below (search this file for "FIX:").
{% endcomment %}

