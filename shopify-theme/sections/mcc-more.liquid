{%- comment -%}
  MCC More / Profile Menu — redesigned to match reference screenshot
  Profile card: avatar left, name+phone right, edit pencil inline
  Banner: dark slate "Never run out of Coffee, Subscribe now →"
  List: large icon circles, clean rows
{%- endcomment -%}
{%- liquid
  if customer
    assign lp = customer.metafields.loyalty.points | default: 0 | plus: 0
    assign tier_name = 'Silver'
    assign tier_next = 1000
    assign tier_min  = 0
    if lp >= 3000
      assign tier_name = 'Platinum'
      assign tier_next = 3000
      assign tier_min  = 3000
    elsif lp >= 1000
      assign tier_name = 'Gold'
      assign tier_next = 3000
      assign tier_min  = 1000
    endif
    assign tier_pct = lp | minus: tier_min | times: 100 | divided_by: tier_next | at_most: 100
  endif
-%}

<style>
#mcc-more,#mcc-more *{box-sizing:border-box;margin:0;padding:0}
#mcc-more{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;font-size:14px;color:#1a1a2e;background:#F4F6FB;-webkit-font-smoothing:antialiased}
#mcc-more a{text-decoration:none;color:inherit}
#mcc-more button{-webkit-tap-highlight-color:transparent}

.mcc-more-panel{display:none;max-width:480px;margin:0 auto;padding-bottom:32px;transition:transform .28s ease,opacity .28s ease;opacity:1}
.mcc-more-panel.active{display:block}

/* Topbar */
.mcc-more-topbar{display:flex;align-items:center;gap:8px;padding:14px 16px;background:#fff}
.mcc-more-back{background:#F0F1FA;border:none;border-radius:50%;width:34px;height:34px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#1a1a2e;flex-shrink:0}
.mcc-more-title{flex:1;text-align:center;font-size:1rem;font-weight:700}

/* Profile card — horizontal layout matching screenshot */
.mcc-more-profile-card{display:flex;align-items:center;gap:14px;padding:18px 16px;margin:16px 16px 0;background:#fff;border-radius:16px;box-shadow:0 2px 10px rgba(20,20,50,.06);position:relative}
.mcc-more-avatar-wrap{position:relative;flex-shrink:0}
.mcc-more-avatar{width:62px;height:62px;border-radius:50%;background:#0a06ff;color:#fff;font-size:1.2rem;font-weight:600;display:flex;align-items:center;justify-content:center;overflow:hidden}
.mcc-more-avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%}
.mcc-more-pct-badge{position:absolute;bottom:-4px;left:50%;transform:translateX(-50%);background:#1a1a2e;color:#fff;font-size:0.58rem;font-weight:700;padding:2px 7px;border-radius:100px;border:2px solid #fff;white-space:nowrap}
.mcc-more-profile-info{flex:1;min-width:0}
.mcc-more-name{font-size:1rem;font-weight:700;line-height:1.2}
.mcc-more-phone{font-size:0.82rem;color:#9a9aad;margin-top:3px}
.mcc-more-edit-pencil{background:#F5F5F8;border:none;border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#4a4a5a;flex-shrink:0}

/* Subscribe banner — dark slate matching reference */
.mcc-more-banner{display:flex;align-items:center;justify-content:space-between;background:#2d3651;padding:22px 20px;margin:12px 16px 0;border-radius:14px;cursor:pointer;text-decoration:none}
.mcc-more-banner-text{font-size:0.92rem;font-weight:600;color:#fff;line-height:1.3}
.mcc-more-banner-arrow{color:#fff;flex-shrink:0;margin-left:12px}

/* Settings list */
.mcc-more-group{background:#fff;margin:12px 16px 0;border-radius:16px;overflow:hidden;box-shadow:0 2px 10px rgba(20,20,50,.06)}
.mcc-more-row{display:flex;align-items:center;gap:14px;padding:19px 16px;cursor:pointer;background:none;border:none;width:100%;text-align:left;font-family:inherit;color:inherit;transition:background .12s}
.mcc-more-row:active{background:#FAFAFC}
.mcc-more-group .mcc-more-row+.mcc-more-row{border-top:1px solid #F0F0F4}
.mcc-more-row-icon{width:44px;height:44px;border-radius:50%;background:#F0F1FA;color:#3a3a4a;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.mcc-more-row-text{flex:1;min-width:0}
.mcc-more-row-title{font-size:0.95rem;font-weight:600;line-height:1.3}
.mcc-more-row-sub{font-size:0.78rem;color:#9a9aad;margin-top:2px}
.mcc-more-row-chev{color:#d0d0da;flex-shrink:0}
.mcc-more-info-sub{padding:2px 16px 12px;background:#fff}
.mcc-more-info-sub a{display:block;padding:9px 4px;font-size:0.83rem;color:#0a06ff;font-weight:600}
.mcc-more-info-sub a+a{border-top:1px solid #F0F0F4}

/* Edit screen */
.mcc-more-edit-body{padding:22px 16px}
.mcc-edit-avatar-wrap{display:flex;justify-content:center;margin-bottom:24px;position:relative}
.mcc-more-avatar.lg{width:88px;height:88px;font-size:1.6rem}
.mcc-more-camera-btn{position:absolute;bottom:-2px;right:-2px;width:28px;height:28px;border-radius:50%;background:#0a06ff;border:2px solid #fff;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#fff}
.mcc-more-field{margin-bottom:14px}
.mcc-more-field label{display:block;font-size:0.7rem;font-weight:700;color:#8582c9;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px}
.mcc-more-field input,.mcc-more-field select{width:100%;height:48px;padding:0 14px;border:none;border-radius:12px;background:#F0F1FA;font-size:0.92rem;font-weight:500;color:#1a1a2e;font-family:inherit}
.mcc-more-field input:focus,.mcc-more-field select:focus{outline:2px solid #0a06ff;background:#fff}
.mcc-more-field input[readonly]{background:#F4F4FA;color:#aaa}
.mcc-phone-row{display:flex;gap:8px}
.mcc-phone-prefix{display:flex;align-items:center;padding:0 12px;border-radius:12px;background:#0a06ff;color:#fff;font-weight:600;font-size:0.88rem;flex-shrink:0}
.mcc-phone-row input{flex:1}
.mcc-more-note{font-size:0.74rem;color:#9a9aad;line-height:1.5;margin:4px 0 20px}
.mcc-more-save-btn{width:100%;height:52px;background:#0a06ff;color:#fff;border:none;border-radius:14px;font-size:0.94rem;font-weight:700;cursor:pointer}
</style>

{%- if customer -%}
<div id="mcc-more">

  <!-- SCREEN 1: PROFILE LIST -->
  <div class="mcc-more-panel active" id="more-panel-list">

    <div class="mcc-more-topbar">
      <a class="mcc-more-back" href="{{ section.settings.back_url | default: '/' }}" aria-label="Back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
      </a>
      <span class="mcc-more-title">Profile</span>
      <span style="width:34px"></span>
    </div>

    <!-- Profile card: horizontal layout -->
    <div class="mcc-more-profile-card" style="margin-top:24px">
      <div class="mcc-more-avatar-wrap">
        <div class="mcc-more-avatar" id="more-av">
          <span id="more-av-init">{{ customer.first_name | slice: 0 | upcase }}{{ customer.last_name | slice: 0 | upcase }}</span>
        </div>
        {%- if customer.metafields.loyalty.points -%}
          <span class="mcc-more-pct-badge">{{ tier_pct }}%</span>
        {%- endif -%}
      </div>
      <div class="mcc-more-profile-info">
        <div class="mcc-more-name">{{ customer.first_name }}</div>
        <div class="mcc-more-phone">
          {%- if customer.phone != blank -%}{{ customer.phone | remove_first: '+91' }}{%- else -%}Add phone number{%- endif -%}
        </div>
      </div>
      <button class="mcc-more-edit-pencil" id="more-edit-btn" type="button" aria-label="Edit profile">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
      </button>
    </div>

    <!-- Settings list -->
    <div class="mcc-more-group">

      <a class="mcc-more-row" href="{{ section.settings.account_page_link | default: '/pages/my-account' }}">
        <span class="mcc-more-row-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg></span>
        <span class="mcc-more-row-text"><span class="mcc-more-row-title">Account</span><br><span class="mcc-more-row-sub">Manage your account</span></span>
        <span class="mcc-more-row-chev"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></span>
      </a>

      <a class="mcc-more-row" href="{{ section.settings.feedback_link | default: '#' }}">
        <span class="mcc-more-row-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
        <span class="mcc-more-row-text"><span class="mcc-more-row-title">Feedback</span><br><span class="mcc-more-row-sub">Share your experience with us</span></span>
        <span class="mcc-more-row-chev"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></span>
      </a>

      <a class="mcc-more-row" href="{{ section.settings.referral_link | default: '#' }}">
        <span class="mcc-more-row-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg></span>
        <span class="mcc-more-row-text"><span class="mcc-more-row-title">Manage Referrals</span><br><span class="mcc-more-row-sub">Refer and Earn</span></span>
        <span class="mcc-more-row-chev"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></span>
      </a>

      <button class="mcc-more-row" id="more-info-toggle" type="button">
        <span class="mcc-more-row-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg></span>
        <span class="mcc-more-row-text"><span class="mcc-more-row-title">General Info</span><br><span class="mcc-more-row-sub">T&amp;C, Privacy policy, FAQs</span></span>
        <span class="mcc-more-row-chev" id="more-info-chev"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></span>
      </button>
      <div class="mcc-more-info-sub" id="more-info-sub" style="display:none">
        {%- if shop.terms_of_service.url -%}<a href="{{ shop.terms_of_service.url }}">Terms of Service</a>{%- endif -%}
        {%- if shop.privacy_policy.url -%}<a href="{{ shop.privacy_policy.url }}">Privacy Policy</a>{%- endif -%}
        {%- if shop.refund_policy.url -%}<a href="{{ shop.refund_policy.url }}">Refund Policy</a>{%- endif -%}
      </div>

      <a class="mcc-more-row" href="{{ routes.account_logout_url }}">
        <span class="mcc-more-row-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></span>
        <span class="mcc-more-row-text"><span class="mcc-more-row-title">Logout</span><br><span class="mcc-more-row-sub">Logout {{ shop.name }}</span></span>
        <span class="mcc-more-row-chev"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></span>
      </a>

      <a class="mcc-more-row" href="mailto:{{ section.settings.support_email | default: 'support@mycoffeeco.com' }}?subject=Account%20deletion%20request&body=Please%20delete%20my%20account%20associated%20with%20{{ customer.email }}">
        <span class="mcc-more-row-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg></span>
        <span class="mcc-more-row-text"><span class="mcc-more-row-title">Delete Account</span><br><span class="mcc-more-row-sub">Removes all your data permanently</span></span>
        <span class="mcc-more-row-chev"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></span>
      </a>

    </div><!-- /.mcc-more-group -->
  </div><!-- /#more-panel-list -->

  <!-- SCREEN 2: EDIT PROFILE -->
  <div class="mcc-more-panel" id="more-panel-edit">
    <div class="mcc-more-topbar">
      <button class="mcc-more-back" id="edit-back-btn" type="button" aria-label="Back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <span class="mcc-more-title">Edit Profile</span>
      <span style="width:34px"></span>
    </div>
    <div class="mcc-more-edit-body">
      <div class="mcc-edit-avatar-wrap">
        <div style="position:relative;display:inline-block">
          <div class="mcc-more-avatar lg" id="edit-av">
            <span id="edit-av-init">{{ customer.first_name | slice: 0 | upcase }}{{ customer.last_name | slice: 0 | upcase }}</span>
          </div>
          <button class="mcc-more-camera-btn" id="edit-camera-btn" type="button" aria-label="Change photo">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          </button>
        </div>
      </div>
      <input type="file" id="more-av-file" accept="image/*" style="display:none">
      <div class="mcc-more-field">
        <label for="edit-name">Name</label>
        <input id="edit-name" type="text" value="{{ customer.first_name | escape }}">
      </div>
      <div class="mcc-more-field">
        <label for="edit-phone">Mobile Number</label>
        <div class="mcc-phone-row">
          <span class="mcc-phone-prefix">🇮🇳 +91</span>
          <input id="edit-phone" type="tel" value="{{ customer.phone | remove_first: '+91' | escape }}" placeholder="Not added">
        </div>
      </div>
      <div class="mcc-more-field">
        <label for="edit-email">Email</label>
        <input id="edit-email" type="email" value="{{ customer.email | escape }}" readonly>
      </div>
      <div class="mcc-more-field">
        <label for="edit-dob">Date of Birth</label>
        <input id="edit-dob" type="date" value="{{ customer.metafields.custom.dob }}">
      </div>
      <div class="mcc-more-field">
        <label for="edit-gender">Gender</label>
        <select id="edit-gender">
          <option value="">Select</option>
          <option value="Female"{% if customer.metafields.custom.gender == 'Female' %} selected{% endif %}>Female</option>
          <option value="Male"{% if customer.metafields.custom.gender == 'Male' %} selected{% endif %}>Male</option>
          <option value="Other"{% if customer.metafields.custom.gender == 'Other' %} selected{% endif %}>Other</option>
        </select>
      </div>
      <p class="mcc-more-note">Name and mobile number save to your account. Date of birth and gender save locally in this browser.</p>
      <button class="mcc-more-save-btn" id="more-save-btn" type="button">Save</button>
    </div>
  </div><!-- /#more-panel-edit -->

</div><!-- /#mcc-more -->
{%- else -%}
<script>window.location.href='/account/login?return_url=/pages/more';</script>
{%- endif -%}
