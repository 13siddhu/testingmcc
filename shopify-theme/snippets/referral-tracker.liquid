{% comment %}
  Referral/Affiliate Tracking Script
  
  Captures referral codes from URL and stores them for order attribution.
  Usage: {% render 'referral-tracker' %}
{% endcomment %}

<script>
(function() {
  'use strict';

  // Referral tracking manager
  const ReferralTracker = {
    
    STORAGE_KEY: 'mcc_referral_code',
    EXPIRY_KEY: 'mcc_referral_expiry',
    EXPIRY_DAYS: 30, // Referral code valid for 30 days
    
    /**
     * Initialize referral tracking
     */
    init() {
      this.captureReferralFromURL();
      this.displayReferralBanner();
      this.injectReferralIntoCheckout();
    },
    
    /**
     * Capture referral code from URL parameter
     */
    captureReferralFromURL() {
      const urlParams = new URLSearchParams(window.location.search);
      const ref = urlParams.get('ref') || urlParams.get('referral') || urlParams.get('code');
      
      if (ref) {
        this.validateAndStore(ref);
      }
    },
    
    /**
     * Validate referral code with backend and store if valid
     */
    async validateAndStore(code) {
      try {
        const response = await fetch(`https://mycoffeeco-middleware-original.onrender.com/api/referrals/validate/${code}`);
        const data = await response.json();
        
        if (data.success && data.valid) {
          // Store referral code
          localStorage.setItem(this.STORAGE_KEY, code.toUpperCase());
          
          // Store expiry date
          const expiryDate = new Date();
          expiryDate.setDate(expiryDate.getDate() + this.EXPIRY_DAYS);
          localStorage.setItem(this.EXPIRY_KEY, expiryDate.toISOString());
          
          console.log('[Referral] Code stored:', code, 'Type:', data.referral.type);
          
          // Show success banner
          this.showBanner(`🎉 You're ordering via ${data.referral.name}'s link!`, 'success');
          
          // Clean URL
          this.cleanURL();
        } else {
          console.warn('[Referral] Invalid code:', code);
        }
      } catch (err) {
        console.error('[Referral] Validation failed:', err);
      }
    },
    
    /**
     * Get stored referral code if not expired
     */
    getReferralCode() {
      const code = localStorage.getItem(this.STORAGE_KEY);
      const expiry = localStorage.getItem(this.EXPIRY_KEY);
      
      if (!code || !expiry) return null;
      
      // Check expiry
      if (new Date(expiry) < new Date()) {
        this.clearReferral();
        return null;
      }
      
      return code;
    },
    
    /**
     * Clear stored referral
     */
    clearReferral() {
      localStorage.removeItem(this.STORAGE_KEY);
      localStorage.removeItem(this.EXPIRY_KEY);
    },
    
    /**
     * Display referral banner if code is active
     */
    displayReferralBanner() {
      const code = this.getReferralCode();
      if (!code) return;
      
      const existingBanner = document.getElementById('referral-banner');
      if (existingBanner) return; // Already shown
      
      this.showBanner(`🎁 Referral code <strong>${code}</strong> applied!`, 'info', true);
    },
    
    /**
     * Show banner notification
     */
    showBanner(message, type = 'info', persistent = false) {
      const banner = document.createElement('div');
      banner.id = 'referral-banner';
      banner.style.cssText = `
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background: ${type === 'success' ? '#10b981' : '#3b82f6'};
        color: white;
        padding: 12px 16px;
        text-align: center;
        font-size: 14px;
        font-weight: 500;
        z-index: 99999;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      `;
      banner.innerHTML = message;
      
      document.body.prepend(banner);
      
      // Add offset to app if exists
      const app = document.getElementById('rista-app');
      if (app) {
        app.style.setProperty('--rista-header-offset', '44px');
      }
      
      if (!persistent) {
        setTimeout(() => {
          banner.remove();
          if (app) app.style.setProperty('--rista-header-offset', '0px');
        }, 5000);
      }
    },
    
    /**
     * Inject referral code into Shopify checkout as note attribute
     */
    injectReferralIntoCheckout() {
      const code = this.getReferralCode();
      if (!code) return;
      
      // Listen for checkout button clicks
      document.addEventListener('click', (e) => {
        const checkoutBtn = e.target.closest('#checkout-btn');
        if (!checkoutBtn) return;
        
        // Store in session for checkout page
        sessionStorage.setItem('mcc_checkout_referral', code);
        console.log('[Referral] Code will be added to checkout:', code);
      });
      
      // If we're on cart page, inject into form
      this.injectIntoCartForm(code);
    },
    
    /**
     * Inject referral into cart form attributes
     */
    injectIntoCartForm(code) {
      const cartForm = document.querySelector('form[action="/cart"]');
      if (!cartForm) return;
      
      // Remove existing referral input
      const existing = cartForm.querySelector('input[name="attributes[referral_code]"]');
      if (existing) existing.remove();
      
      // Add hidden input
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'attributes[referral_code]';
      input.value = code;
      cartForm.appendChild(input);
      
      console.log('[Referral] Injected into cart form:', code);
    },
    
    /**
     * Remove referral params from URL
     */
    cleanURL() {
      if (!window.history.replaceState) return;
      
      const url = new URL(window.location.href);
      url.searchParams.delete('ref');
      url.searchParams.delete('referral');
      url.searchParams.delete('code');
      
      window.history.replaceState({}, document.title, url.toString());
    },
    
    /**
     * Add referral to cart note during checkout
     */
    addToCartNote(cart) {
      const code = this.getReferralCode();
      if (!code) return cart;
      
      // Add referral to note attributes
      if (!cart.attributes) cart.attributes = {};
      cart.attributes.referral_code = code;
      
      return cart;
    }
  };
  
  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => ReferralTracker.init());
  } else {
    ReferralTracker.init();
  }
  
  // Expose globally for cart integration
  window.ReferralTracker = ReferralTracker;
  
})();
</script>

<style>
  #referral-banner {
    animation: slideDown 0.3s ease-out;
  }
  
  @keyframes slideDown {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>
